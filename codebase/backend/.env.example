# ==========================================
# CẤU HÌNH CƠ BẢN (APP SETTINGS)
# ==========================================
PROJECT_NAME="PI-RAG Security Checker"
VERSION="1.0.0"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["*","http://localhost:5173"]

# ==========================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU (DATABASE)
# ==========================================
# Mặc định sử dụng SQLite cho môi trường local/dev
DATABASE_URL="sqlite:///./sqlite.db"
# Nếu dùng PostgreSQL cho production, thay thế bằng:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/pirag_db"

# ==========================================
# CẤU HÌNH AI & VECTOR STORE (CHROMA DB)
# ==========================================
# Nơi lưu trữ vector database (đường dẫn tương đối so với thư mục chạy lệnh)
CHROMA_PATH="./chroma_db"
# Host và Port nếu chạy ChromaDB bằng Docker (để trống nếu dùng local file)
CHROMA_HOST=""
CHROMA_PORT=8000
CHROMA_DEFAULT_COLLECTION="default_collection"
# Model embedding cho tiếng Việt (dùng HuggingFace)
HF_EMBEDDING_MODEL="bkai-foundation-models/vietnamese-bi-encoder"

# ==========================================
# CẤU HÌNH LLM (OPENROUTER / OLLAMA)
# ==========================================
# Cấu hình để gọi các model đóng vai Hacker (Red-Team) hoặc Judge.

# Lựa chọn 1: Dùng OpenRouter (Mặc định)
# LLM_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_MODEL="openai/gpt-4o-mini"

# Lựa chọn 2: Dùng Ollama Local (để test offline, miễn phí)
# Nếu bạn đang chạy Ollama, hãy bỏ comment 3 dòng dưới đây:
LLM_API_KEY="ollama"
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="llama3" # Thay bằng model bạn đã pull về (vd: mistral, qwen2)
